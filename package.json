{
  "name": "m2m-expressjs-demo-app",
  "description": "This is a server-only demo powered by Wristband to show how to protect APIs with machine-to-machine OAuth clients. This is simulating a microservice scenario.",
  "author": "Wristband",
  "version": "0.1.0",
  "license": "MIT",
  "private": false,
  "homepage": "https://wristband.dev",
  "repository": {
    "type": "git",
    "url": "git@github.com:wristband-dev/m2m-expressjs-demo-app.git"
  },
  "bugs": {
    "email": "support@wristband.dev"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.6.0"
  },
  "main": "src/server.js",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 nodemon",
    "start": "node -r dotenv/config dist/server.js",
    "lint": "eslint src --ext .js,.ts",
    "lint:fix": "eslint src --ext .js,.ts --fix"
  },
  "dependencies": {
    "@wristband/node-m2m-auth": "^1.0.5",
    "@wristband/typescript-jwt": "^0.1.0",
    "agentkeepalive": "^4.6.0",
    "async-retry": "^1.3.3",
    "axios": "^1.10.0",
    "express": "^5.1.0",
    "stoppable": "^1.1.0"
  },
  "devDependencies": {
    "@types/async-retry": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.10",
    "@types/stoppable": "^1.1.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-node": "^4.1.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "nodemon": "^3.1.10",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "wristband",
    "authentication",
    "openid connect",
    "oidc",
    "oauth2",
    "multi tenant",
    "multi-tenant",
    "b2b",
    "m2m",
    "machine-to-machine",
    "jwt",
    "jwks",
    "token",
    "typescript"
  ]
}
